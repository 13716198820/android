<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_weight="0"
            android:background="#3F51B5"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|center_vertical"
                android:text="(player)"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/score"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|center_vertical"
                android:text="0"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/time"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_horizontal|center_vertical"
                android:text="(time)"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_list" >

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|left"
                android:rotationX="180"
                android:rotationY="0">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/side4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleX="1"
                        android:scaleY="1"
                        android:src="@drawable/side1" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/side4active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:rotationY="0"
                        android:src="@drawable/side1active" />
                </FrameLayout>

            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|right"
                android:rotationX="180"
                android:rotationY="180">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/side3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleX="1"
                        android:scaleY="1"
                        android:src="@drawable/side1" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/side3active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:rotationY="0"
                        android:src="@drawable/side1active" />
                </FrameLayout>

            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|left">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/side1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleX="1"
                        android:scaleY="1"
                        android:src="@drawable/side1" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/side1active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:rotationY="0"
                        android:src="@drawable/side1active" />
                </FrameLayout>

            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|top"
                android:rotationY="180">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/side2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleX="1"
                        android:scaleY="1"
                        android:src="@drawable/side1" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/side2active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:rotationY="0"
                        android:src="@drawable/side1active" />
                </FrameLayout>

            </FrameLayout>

            <ImageView
                android:id="@+id/mouseholder"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:onClick="killmouse"
                />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_weight="0"
            android:background="#3F51B5"
            android:orientation="horizontal">

            <Button
                android:id="@+id/newgame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="New Game"
                android:onClick="newGame"
                />

            <Button
                android:id="@+id/stop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Stop"
                android:onClick="stop"
                />

            <Button
                android:id="@+id/rank"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:onClick="rank"
                android:text="Rank" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>



